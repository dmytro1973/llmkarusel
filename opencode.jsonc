{
  "$schema": "https://opencode.ai/config.json",
  "model": "llmkarusel/auto",
  "username": "llmkarusel",
  "providers": {
    "llmkarusel": {
      "name": "llmkarusel",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:4127/v1",
        "apiKey": "llmkarusel-local",
      },
      "models": {
        "auto": {
          "name": "auto",
          "limit": {
            "context": 128000,
            "output": 8192,
          },
          "capabilities": {
            "tools": {
              "supported": true,
            },
            "temperature": true,
            "input": ["text"],
            "output": ["text"],
          },
        },
      },
    },
  },
  "policies": [
    {
      "action": "provider.use",
      "resource": "opencode",
      "effect": "deny",
    },
  ],
}
